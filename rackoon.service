# Copy to /etc/systemd/system/, adjust User and paths, then:
#   sudo systemctl enable --now rackoon
[Unit]
Description=Rackoon server manager
After=network-online.target
Wants=network-online.target

[Service]
User=YOUR_USER
WorkingDirectory=/opt/rackoon
ExecStart=/opt/rackoon/run.sh
Restart=on-failure

[Install]
WantedBy=multi-user.target
